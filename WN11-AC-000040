# YOUR CODE GOES HERE

# Ensure administrative privileges
if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Error "This script must be run as an Administrator."
    exit 1
}

$TempCfg = "$env:TEMP\secpol.cfg"
$TempSdb = "$env:TEMP\secpol.sdb"

# 1. Export current Local Security Policy settings
secedit /export /cfg $TempCfg | Out-Null

# 2. Read configuration content
$CfgContent = Get-Content -Path $TempCfg

# 3. Modify PasswordComplexity under [System Access] (1 = Enabled)
if ($CfgContent -match "PasswordComplexity\s*=\s*\d") {
    $CfgContent = $CfgContent -replace "PasswordComplexity\s*=\s*\d", "PasswordComplexity = 1"
} else {
    $CfgContent = $CfgContent -replace "\[System Access\]", "[System Access]`r`nPasswordComplexity = 1"
}

# 4. Save updated configuration file
$CfgContent | Set-Content -Path $TempCfg -Encoding ASCII

# 5. Import and apply updated security policy
secedit /configure /db $TempSdb /cfg $TempCfg /areas SECURITYPOLICY | Out-Null

# 6. Clean up temporary files
Remove-Item -Path $TempCfg, $TempSdb -Force -ErrorAction SilentlyContinue

Write-Host "STIG Password Policy applied successfully. 'Password must meet complexity requirements' set to Enabled." -ForegroundColor Green
