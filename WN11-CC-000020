# YOUR CODE GOES HERE

# Ensure administrative privileges
if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Error "This script must be run as an Administrator."
    exit 1
}

# Set the source directory where your unzipped STIG MSS-Legacy files are located
$SourceFolder = "C:\Path\To\STIG_Templates"  # Update this path

$AdmxSource = Join-Path -Path $SourceFolder -ChildPath "MSS-Legacy.admx"
$AdmlSource = Join-Path -Path $SourceFolder -ChildPath "MSS-Legacy.adml"

$AdmxDestination = "C:\Windows\PolicyDefinitions"
$AdmlDestination = "C:\Windows\PolicyDefinitions\en-US"

# 1. Copy Group Policy Templates (if source files exist)
if ((Test-Path $AdmxSource) -and (Test-Path $AdmlSource)) {
    Copy-Item -Path $AdmxSource -Destination $AdmxDestination -Force
    Copy-Item -Path $AdmlSource -Destination $AdmlDestination -Force
    Write-Host "MSS-Legacy ADMX and ADML files successfully installed." -ForegroundColor Green
} else {
    Write-Warning "Source template files were not found at '$SourceFolder'. Skipping template copy."
}

# 2. Configure System Registry (WN11-CC-000020)
$RegistryPath = "HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip6\Parameters"
$ValueName    = "DisableIPSourceRouting"
$DesiredValue = 2

if (-not (Test-Path -Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

Set-ItemProperty -Path $RegistryPath -Name $ValueName -Value $DesiredValue -Type DWord -Force
Write-Host "STIG WN11-CC-000020 applied successfully. IPv6 DisableIPSourceRouting set to $DesiredValue." -ForegroundColor Green
