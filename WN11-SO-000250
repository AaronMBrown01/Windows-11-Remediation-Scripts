# Ensure administrative privileges
if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Error "This script must be run as an Administrator."
    exit 1
}

$RegistryPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
$ValueName    = "ConsentPromptBehaviorAdmin"
$DesiredValue = 2

# Create registry key path if missing
if (-not (Test-Path -Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

# Apply the security policy value as a DWORD (REG_DWORD)
Set-ItemProperty -Path $RegistryPath -Name $ValueName -Value $DesiredValue -Type DWord -Force

Write-Host "STIG WN11-SO-000250 applied successfully. ConsentPromptBehaviorAdmin set to $DesiredValue (Prompt for consent on the secure desktop)." -ForegroundColor Green
