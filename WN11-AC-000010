# YOUR CODE GOES HERE

# =====================================================================
# STIG Remediation Script
# STIG ID:          WN11-AC-000010
# Vulnerability ID: V-253298
# Severity:         CAT II
# CCI:              CCI-000044
#
# Requirement:
# Account lockout threshold must be between 1 and 3 invalid attempts.
# =====================================================================

# Require Administrator privileges
$CurrentUser = [Security.Principal.WindowsIdentity]::GetCurrent()
$Principal = New-Object Security.Principal.WindowsPrincipal($CurrentUser)

if (-not $Principal.IsInRole(
    [Security.Principal.WindowsBuiltInRole]:: Administrator
)) {
    Write-Error "Administrator privileges are required."
    exit 1
}

Write-Host "Checking WN11-AC-000010..." -ForegroundColor Cyan

# Export current local security policy
$TempFile = Join-Path $env:TEMP "STIG_SecurityPolicy.cfg"

secedit /export /cfg $TempFile /quiet

$Policy = Get-Content $TempFile

$ThresholdLine = $Policy |
    Where-Object { $_ -match "^LockoutBadCount\s*=" }

if ($ThresholdLine) {

    $CurrentThreshold = [int](
        ($ThresholdLine -split "=")[1].Trim()
    )

    Write-Host "Current Account Lockout Threshold: $CurrentThreshold"

    if ($CurrentThreshold -ge 1 -and $CurrentThreshold -le 3) {

        Write-Host "COMPLIANT: WN11-AC-000010" -ForegroundColor Green
        Write-Host "No remediation required."

    }
    else {

        Write-Host "NON-COMPLIANT: WN11-AC-000010" -ForegroundColor Yellow
        Write-Host "Setting Account Lockout Threshold to 3..."

        net accounts /lockoutthreshold:3 | Out-Null

        if ($LASTEXITCODE -eq 0) {
            Write-Host "REMEDIATED: Account Lockout Threshold = 3" `
                -ForegroundColor Green
        }
        else {
            Write-Error "Remediation failed."
            exit 1
        }
    }

}
else {

    Write-Warning "Unable to determine the current lockout threshold."

    Write-Host "Applying STIG-required value of 3..."

    net accounts /lockoutthreshold:3 | Out-Null

}

# Clean up temporary file
Remove-Item $TempFile -Force -ErrorAction SilentlyContinue

Write-Host "`nEffective account policy:" -ForegroundColor Cyan
net accounts
