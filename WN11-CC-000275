# Ensure administrative privileges
if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Error "This script must be run as an Administrator."
    exit 1
}

# Install and import the PolicyFileEditor module if not already available
if (-not (Get-Module -ListAvailable -Name PolicyFileEditor)) {
    Write-Host "Installing PolicyFileEditor module..." -ForegroundColor Yellow
    Install-Module -Name PolicyFileEditor -Force -Scope CurrentUser
}
Import-Module PolicyFileEditor

$PolFilePath = "$env:SystemRoot\System32\GroupPolicy\Machine\registry.pol"
$RegKey      = "SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services"
$RegValue    = "fDisableCdm"
$RegData     = 1

# 1. Update the Local GPO state (registry.pol) so it displays in gpedit.msc
Set-PolicyFileEntry -Path $PolFilePath -Key $RegKey -ValueName $RegValue -Data $RegData -Type DWord

# 2. Update active registry enforcement
$RegistryPath = "HKLM:\$RegKey"
if (-not (Test-Path -Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}
Set-ItemProperty -Path $RegistryPath -Name $RegValue -Value $RegData -Type DWord -Force

# 3. Refresh Group Policy engine
gpupdate /force

Write-Host "Local GPO updated. 'Do not allow drive redirection' now shows as Enabled in gpedit.msc." -ForegroundColor Green


