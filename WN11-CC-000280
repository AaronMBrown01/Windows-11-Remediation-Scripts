<#
.SYNOPSIS
    This setting controls whether users can supply passwords automatically as part
    of their Remote Desktop connection. Enabling this setting forces Windows to
    always prompt the client for a password upon connection.

.NOTES
    Author          : Aaron M Brown
    LinkedIn        : https://www.linkedin.com/in/aaron-m-brown-9a2b76258/
    GitHub          : https://github.com/AaronMBrown01
    Date Created    : 2026-08-18
    Last Modified   : 2026-08-28
    Version         : 2.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000280
    Documentation   : https://stigaview.com/products/win11/v2r8/WN11-CC-000280/

.TESTED ON
    Date(s) Tested  :
    Tested By       :
    Systems Tested  :
    PowerShell Ver. :

.USAGE
    Run from an elevated PowerShell session.

    Example syntax:
    PS C:\> .\STIG-ID-WN11-CC-000280.ps1
#>


<#
.SYNOPSIS
    Remediates STIG WN11-CC-000280.

.DESCRIPTION
    Configures:

    Computer Configuration
      > Administrative Templates
      > Windows Components
      > Remote Desktop Services
      > Remote Desktop Session Host
      > Security
      > Always prompt for password upon connection

    Required setting:
      Enabled

    Required registry value:

    HKLM\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services

    fPromptForPassword = 1 (REG_DWORD)

.NOTES
    STIG-ID : WN11-CC-000280
    Version : 2.0

    IMPORTANT:
    This version does NOT delete or manually overwrite the active Registry.pol.
    It creates a temporary Registry.pol and imports the required setting through
    Microsoft LGPO.exe.
#>


$ErrorActionPreference = "Stop"


# ================================================================
# VARIABLES
# ================================================================

$STIGFolder    = "C:\STIG"

$PolicyKey     = "SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services"
$RegistryPath  = "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services"

$ValueName     = "fPromptForPassword"
$RequiredValue = 1

$MachineRegistryPol = "$env:SystemRoot\System32\GroupPolicy\Machine\Registry.pol"

$TempLGPOText    = Join-Path $env:TEMP "WN11-CC-000280.txt"
$TempRegistryPol = Join-Path $env:TEMP "WN11-CC-000280-Registry.pol"

$LGPOZip     = Join-Path $STIGFolder "LGPO.zip"
$LGPOExtract = Join-Path $STIGFolder "LGPO"


# ================================================================
# HELPER FUNCTION
# ================================================================

function Stop-STIGScript {

    param(
        [string]$Message
    )

    Write-Host ""
    Write-Host "====================================================" -ForegroundColor Red
    Write-Host " WN11-CC-000280 - ERROR" -ForegroundColor Red
    Write-Host "====================================================" -ForegroundColor Red
    Write-Host ""
    Write-Host $Message -ForegroundColor Red
    Write-Host ""

    Read-Host "Press ENTER to close"
    exit 1
}


# ================================================================
# ADMINISTRATOR CHECK
# ================================================================

$Identity  = [Security.Principal.WindowsIdentity]::GetCurrent()
$Principal = New-Object Security.Principal.WindowsPrincipal($Identity)

if (-not $Principal.IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator
)) {
    Stop-STIGScript "PowerShell must be run as Administrator."
}


Write-Host ""
Write-Host "====================================================" -ForegroundColor Cyan
Write-Host " WN11-CC-000280 REMEDIATION" -ForegroundColor Cyan
Write-Host "====================================================" -ForegroundColor Cyan
Write-Host ""


# ================================================================
# CREATE WORKING DIRECTORY
# ================================================================

if (-not (Test-Path $STIGFolder)) {

    New-Item `
        -Path $STIGFolder `
        -ItemType Directory `
        -Force |
        Out-Null
}


# ================================================================
# [1] LOCATE LGPO.EXE
# ================================================================

Write-Host "[1] Searching for LGPO.exe..." -ForegroundColor Cyan


$LGPO = Get-ChildItem `
    -Path $STIGFolder `
    -Filter "LGPO.exe" `
    -File `
    -Recurse `
    -ErrorAction SilentlyContinue |
    Select-Object -First 1 -ExpandProperty FullName


if (-not $LGPO) {

    $PossiblePaths = @(

        "$PSScriptRoot\LGPO.exe"

        "C:\Windows\System32\LGPO.exe"

        "C:\Tools\LGPO.exe"

        "C:\LGPO\LGPO.exe"

        "C:\STIG\LGPO\LGPO_30\LGPO.exe"
    )


    $LGPO = $PossiblePaths |
        Where-Object { Test-Path $_ } |
        Select-Object -First 1
}


# ================================================================
# DOWNLOAD LGPO IF NECESSARY
# ================================================================

if (-not $LGPO) {

    Write-Host ""
    Write-Host "    LGPO.exe not found." -ForegroundColor Yellow
    Write-Host "    Downloading Microsoft LGPO.zip..." -ForegroundColor Yellow
    Write-Host ""


    $LGPOUrl =
        "https://download.microsoft.com/download/8/5/C/85C25433-A1B0-4FFA-9429-7E023E7DA8D8/LGPO.zip"


    try {

        [Net.ServicePointManager]::SecurityProtocol =
            [Net.ServicePointManager]::SecurityProtocol `
            -bor `
            [Net.SecurityProtocolType]::Tls12


        Invoke-WebRequest `
            -Uri $LGPOUrl `
            -OutFile $LGPOZip `
            -UseBasicParsing


        if (Test-Path $LGPOExtract) {

            Remove-Item `
                $LGPOExtract `
                -Recurse `
                -Force
        }


        Expand-Archive `
            -Path $LGPOZip `
            -DestinationPath $LGPOExtract `
            -Force


        $LGPO = Get-ChildItem `
            -Path $LGPOExtract `
            -Filter "LGPO.exe" `
            -File `
            -Recurse `
            -ErrorAction SilentlyContinue |
            Select-Object -First 1 -ExpandProperty FullName
    }
    catch {

        Stop-STIGScript `
            "Unable to download or extract LGPO.zip. $($_.Exception.Message)"
    }
}


if (-not $LGPO) {

    Stop-STIGScript "LGPO.exe could not be located."
}


Write-Host "    Found: $LGPO" -ForegroundColor Green
Write-Host ""


# ================================================================
# [2] VERIFY LGPO DIGITAL SIGNATURE
# ================================================================

Write-Host "[2] Verifying LGPO.exe..." -ForegroundColor Cyan


$Signature = Get-AuthenticodeSignature $LGPO


if ($Signature.Status -ne "Valid") {

    Stop-STIGScript `
        "LGPO.exe does not have a valid digital signature."
}


if ($Signature.SignerCertificate.Subject -notmatch "Microsoft") {

    Stop-STIGScript `
        "LGPO.exe is not signed by Microsoft."
}


Write-Host "    Microsoft signature verified." -ForegroundColor Green
Write-Host ""


# ================================================================
# [3] CREATE LGPO POLICY DEFINITION
# ================================================================

Write-Host "[3] Creating policy definition..." -ForegroundColor Cyan


$PolicyText = @(

    "Computer"

    $PolicyKey

    $ValueName

    "DWORD:1"

    ""

) -join "`r`n"


[System.IO.File]::WriteAllText(
    $TempLGPOText,
    $PolicyText,
    [System.Text.Encoding]::ASCII
)


if (-not (Test-Path $TempLGPOText)) {

    Stop-STIGScript `
        "Unable to create temporary LGPO policy definition."
}


Write-Host "    Policy definition created." -ForegroundColor Green
Write-Host ""


# ================================================================
# [4] BUILD TEMPORARY REGISTRY.POL
# ================================================================

Write-Host "[4] Building temporary Registry.pol..." -ForegroundColor Cyan


Remove-Item `
    $TempRegistryPol `
    -Force `
    -ErrorAction SilentlyContinue


& $LGPO `
    /r $TempLGPOText `
    /w $TempRegistryPol `
    /v


if ($LASTEXITCODE -ne 0) {

    Stop-STIGScript `
        "LGPO failed to build the temporary Registry.pol."
}


if (-not (Test-Path $TempRegistryPol)) {

    Stop-STIGScript `
        "Temporary Registry.pol was not created."
}


Write-Host "    Temporary Registry.pol created." -ForegroundColor Green
Write-Host ""


# ================================================================
# [5] IMPORT INTO LOCAL GROUP POLICY
# ================================================================

Write-Host "[5] Importing into Local Group Policy..." -ForegroundColor Cyan


& $LGPO `
    /m $TempRegistryPol `
    /v


if ($LASTEXITCODE -ne 0) {

    Stop-STIGScript `
        "LGPO failed to import WN11-CC-000280."
}


Write-Host "    Local Group Policy updated." -ForegroundColor Green
Write-Host ""


# ================================================================
# [6] ENSURE EFFECTIVE REGISTRY VALUE
# ================================================================

Write-Host "[6] Ensuring effective registry value..." -ForegroundColor Cyan


if (-not (Test-Path $RegistryPath)) {

    New-Item `
        -Path $RegistryPath `
        -Force |
        Out-Null
}


New-ItemProperty `
    -Path $RegistryPath `
    -Name $ValueName `
    -PropertyType DWord `
    -Value $RequiredValue `
    -Force |
    Out-Null


$CurrentValue = (
    Get-ItemProperty `
        -Path $RegistryPath `
        -Name $ValueName `
        -ErrorAction Stop
).$ValueName


if ($CurrentValue -ne $RequiredValue) {

    Stop-STIGScript `
        "Failed to configure fPromptForPassword."
}


Write-Host "    fPromptForPassword = 1" -ForegroundColor Green
Write-Host ""


# ================================================================
# [7] RUN GPUPDATE
# ================================================================

Write-Host "[7] Running GPUPDATE..." -ForegroundColor Cyan


gpupdate.exe `
    /target:computer `
    /force |
    Out-Host


if ($LASTEXITCODE -ne 0) {

    Stop-STIGScript `
        "GPUPDATE returned an error."
}


Write-Host ""
Write-Host "    Group Policy update complete." -ForegroundColor Green
Write-Host ""


# ================================================================
# [8] VERIFY ACTIVE REGISTRY.POL
# ================================================================

Write-Host "[8] Verifying active Registry.pol..." -ForegroundColor Cyan


if (-not (Test-Path $MachineRegistryPol)) {

    Stop-STIGScript `
        "Active Machine Registry.pol was not found."
}


$ParsedPolicy = & $LGPO `
    /parse `
    /m $MachineRegistryPol


if ($LASTEXITCODE -ne 0) {

    Stop-STIGScript `
        "LGPO was unable to parse the active Registry.pol."
}


$ParsedText = $ParsedPolicy -join "`n"


#
# Verify the actual policy block instead of merely checking whether
# the individual strings occur somewhere in Registry.pol.
#

$ExpectedBlock = @"
Computer
$PolicyKey
$ValueName
DWORD:1
"@


$NormalizedParsed = $ParsedText `
    -replace "`r", "" `
    -replace "[ \t]+(?=`n)", ""


$NormalizedExpected = $ExpectedBlock `
    -replace "`r", ""


if ($NormalizedParsed -notmatch [regex]::Escape($NormalizedExpected)) {

    Write-Host ""
    Write-Host "Active Registry.pol does not contain the expected policy block:" `
        -ForegroundColor Yellow

    Write-Host ""
    Write-Host $ExpectedBlock -ForegroundColor Yellow
    Write-Host ""

    Stop-STIGScript `
        "WN11-CC-000280 was not verified in active Registry.pol."
}


Write-Host "    Registry.pol policy entry verified." -ForegroundColor Green
Write-Host ""


# ================================================================
# [9] VERIFY LIVE REGISTRY AFTER GPUPDATE
# ================================================================

Write-Host "[9] Verifying live registry..." -ForegroundColor Cyan


try {

    $PostGPValue = (
        Get-ItemProperty `
            -Path $RegistryPath `
            -Name $ValueName `
            -ErrorAction Stop
    ).$ValueName
}
catch {

    Stop-STIGScript `
        "fPromptForPassword disappeared after Group Policy processing."
}


if ($PostGPValue -ne $RequiredValue) {

    Stop-STIGScript `
        "fPromptForPassword is not equal to 1 after GPUPDATE."
}


reg.exe query `
    "HKLM\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services" `
    /v fPromptForPassword


if ($LASTEXITCODE -ne 0) {

    Stop-STIGScript `
        "REG.EXE could not verify fPromptForPassword."
}


Write-Host ""


# ================================================================
# FINAL RESULT
# ================================================================

Write-Host "====================================================" -ForegroundColor Green
Write-Host " WN11-CC-000280 - PASS" -ForegroundColor Green
Write-Host "====================================================" -ForegroundColor Green
Write-Host ""

Write-Host "Policy:" -ForegroundColor White
Write-Host "  Always prompt for password upon connection" -ForegroundColor Green
Write-Host ""

Write-Host "Policy State       : ENABLED" -ForegroundColor Green
Write-Host "Registry.pol       : VERIFIED" -ForegroundColor Green
Write-Host "fPromptForPassword : REG_DWORD 0x1" -ForegroundColor Green
Write-Host "Post-GPUPDATE      : VERIFIED" -ForegroundColor Green
Write-Host ""


# ================================================================
# CLEANUP
# ================================================================

Remove-Item `
    $TempLGPOText `
    -Force `
    -ErrorAction SilentlyContinue


Remove-Item `
    $TempRegistryPol `
    -Force `
    -ErrorAction SilentlyContinue


Read-Host "Press ENTER to close"
