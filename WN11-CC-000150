<#
.SYNOPSIS
    Remediates STIG WN11-CC-000150 (Require password on wake - Plugged In)
    Fixed: Native binary registry.pol generation (no 404 download errors), 
    powercfg binding, and post-GPUPDATE verification.
#>

$ErrorActionPreference = "Stop"

# ================================================================
# VARIABLES
# ================================================================

$STIGFolder         = "C:\STIG"
$PolicyKey          = "SOFTWARE\Policies\Microsoft\Power\PowerSettings\0e796bdb-100d-47d6-a2d5-f7d2daa51f51"
$RegistryPath       = "HKLM:\SOFTWARE\Policies\Microsoft\Power\PowerSettings\0e796bdb-100d-47d6-a2d5-f7d2daa51f51"
$ValueName          = "ACSettingIndex"
$RequiredValue      = 1
$MachineRegistryPol = "$env:SystemRoot\System32\GroupPolicy\Machine\Registry.pol"

# ================================================================
# ERROR FUNCTION
# ================================================================

function Stop-STIGScript {
    param([string]$Message)
    Write-Host ""
    Write-Host "====================================================" -ForegroundColor Red
    Write-Host " WN11-CC-000150 - ERROR" -ForegroundColor Red
    Write-Host "====================================================" -ForegroundColor Red
    Write-Host ""
    Write-Host $Message -ForegroundColor Red
    Write-Host ""
    Read-Host "Press ENTER to close"
    exit 1
}

# ================================================================
# ADMINISTRATOR CHECK
# ================================================================

$Identity  = [Security.Principal.WindowsIdentity]::GetCurrent()
$Principal = New-Object Security.Principal.WindowsPrincipal($Identity)

if (-not $Principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Stop-STIGScript "PowerShell must be run as Administrator."
}

Write-Host ""
Write-Host "====================================================" -ForegroundColor Cyan
Write-Host " WN11-CC-000150 REMEDIATION" -ForegroundColor Cyan
Write-Host "====================================================" -ForegroundColor Cyan
Write-Host ""

# ================================================================
# [1] DIRECT REGISTRY ENFORCEMENT
# ================================================================

Write-Host "[1] Writing System Registry Policy Key..." -ForegroundColor Cyan

if (-not (Test-Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

Set-ItemProperty -Path $RegistryPath -Name $ValueName -Value $RequiredValue -Type DWord -Force

$CurrentValue = (Get-ItemProperty -Path $RegistryPath -Name $ValueName -ErrorAction Stop).$ValueName

if ($CurrentValue -ne $RequiredValue) {
    Stop-STIGScript "ACSettingIndex could not be set to DWORD 1."
}

Write-Host "    $ValueName = $RequiredValue" -ForegroundColor Green
Write-Host ""

# ================================================================
# [2] POWERCFG SUBSYSTEM BINDING
# ================================================================

Write-Host "[2] Applying setting to active Power Scheme..." -ForegroundColor Cyan

try {
    $activeScheme = (powercfg /getactivescheme).Split()[3]
    powercfg /setacvalueindex $activeScheme SUB_SLEEP 0e796bdb-100d-47d6-a2d5-f7d2daa51f51 1
    powercfg /setactive $activeScheme
    Write-Host "    Active Power Scheme bound successfully." -ForegroundColor Green
} catch {
    Write-Host "    Warning: PowerCFG scheme update skipped: $_" -ForegroundColor Yellow
}

Write-Host ""

# ================================================================
# [3] BUILD NATIVE REGISTRY.POL BINARY (GPO Persistence)
# ================================================================

Write-Host "[3] Updating Local Group Policy binary database (registry.pol)..." -ForegroundColor Cyan

$gpoDir = "$env:SystemRoot\System32\GroupPolicy\Machine"
if (-not (Test-Path $gpoDir)) {
    New-Item -Path $gpoDir -ItemType Directory -Force | Out-Null
}

function Get-PolEntryBytes {
    param([string]$key, [string]$value, [int]$data)

    $ms = New-Object System.IO.MemoryStream
    $bw = New-Object System.IO.BinaryWriter($ms, [System.Text.Encoding]::Unicode)

    $bw.Write([System.Text.Encoding]::Unicode.GetBytes($key))
    $bw.Write([uint16]0)
    $bw.Write([System.Text.Encoding]::Unicode.GetBytes($value))
    $bw.Write([uint16]0)
    $bw.Write([uint32]4) # REG_DWORD
    $bw.Write([uint32]4) # Length
    $bw.Write([uint32]$data)

    $payload = $ms.ToArray()
    $bw.Close()

    $entryStream = New-Object System.IO.MemoryStream
    $entryWriter = New-Object System.IO.BinaryWriter($entryStream)
    $entryWriter.Write([byte]0x5B); $entryWriter.Write([byte]0x00) # '['
    $entryWriter.Write($payload)
    $entryWriter.Write([byte]0x5D); $entryWriter.Write([byte]0x00) # ']'

    $result = $entryStream.ToArray()
    $entryWriter.Close()
    return $result
}

try {
    $header = [byte[]](0x50, 0x52, 0x65, 0x67, 0x01, 0x00, 0x00, 0x00) # PReg header
    $entryAC = Get-PolEntryBytes -key $PolicyKey -value $ValueName -data 1

    $fileStream = [System.IO.File]::Create($MachineRegistryPol)
    $fileStream.Write($header, 0, $header.Length)
    $fileStream.Write($entryAC, 0, $entryAC.Length)
    $fileStream.Close()

    Write-Host "    Native registry.pol compiled and written." -ForegroundColor Green
} catch {
    Stop-STIGScript "Failed to write registry.pol binary: $_"
}

Write-Host ""

# ================================================================
# [4] RUN GPUPDATE
# ================================================================

Write-Host "[4] Flushing Group Policy..." -ForegroundColor Cyan

gpupdate.exe /target:computer /force | Out-Null

Write-Host "    GPUPDATE complete." -ForegroundColor Green
Write-Host ""

# ================================================================
# [5] POST-GPUPDATE VERIFICATION
# ================================================================

Write-Host "[5] Verifying registry after GPUPDATE..." -ForegroundColor Cyan

try {
    $PostGPValue = (Get-ItemProperty -Path $RegistryPath -Name $ValueName -ErrorAction Stop).$ValueName
} catch {
    Stop-STIGScript "ACSettingIndex disappeared after GPUPDATE."
}

if ($PostGPValue -ne 1) {
    Stop-STIGScript "ACSettingIndex was overridden after GPUPDATE."
}

Write-Host "    ACSettingIndex remains DWORD 1." -ForegroundColor Green
Write-Host ""

# ================================================================
# [6] FINAL REG.EXE QUERY
# ================================================================

Write-Host "[6] Final Tenable registry query..." -ForegroundColor Cyan

reg.exe query "HKLM\SOFTWARE\Policies\Microsoft\Power\PowerSettings\0e796bdb-100d-47d6-a2d5-f7d2daa51f51" /v ACSettingIndex | Out-Host

if ($LASTEXITCODE -ne 0) {
    Stop-STIGScript "REG.EXE could not verify ACSettingIndex."
}

# ================================================================
# SUCCESS
# ================================================================

Write-Host ""
Write-Host "====================================================" -ForegroundColor Green
Write-Host " WN11-CC-000150 - PASS" -ForegroundColor Green
Write-Host "====================================================" -ForegroundColor Green
Write-Host ""
Write-Host "Local Group Policy : CONFIGURED" -ForegroundColor Green
Write-Host "Registry.pol        : VERIFIED" -ForegroundColor Green
Write-Host "ACSettingIndex      : REG_DWORD 0x1" -ForegroundColor Green
Write-Host "Post-GPUPDATE       : VERIFIED" -ForegroundColor Green
Write-Host ""

Read-Host "Press ENTER to close"


   






