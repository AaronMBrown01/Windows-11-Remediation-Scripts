<#
.SYNOPSIS
    This PowerShell script ensures that Windows 11 prompts users for a password when waking from sleep while on AC power (plugged in).

.NOTES
    Author          : Aaron M Brown
    LinkedIn        : https://www.linkedin.com/in/aaron-m-brown-9a2b76258/
    GitHub          : https://github.com/AaronMBrown01
    Date Created    : 2026-08-18
    Last Modified   : 2026-08-18
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000150
    Documentation   : https://stigaview.com/products/win11/v2r8/WN11-CC-000150/

.TESTED ON
    Date(s) Tested  : 
    Tested By       : 
    Systems Tested  : 
    PowerShell Ver. : 

.USAGE
    Put any usage instructions here.
    Example syntax:
    PS C:\> .\STIG-ID-WN11-CC-000150.ps1 
#>

# YOUR CODE GOES HERE

# =====================================================================
# STIG ID: WN11-CC-000150
#
# Require a password when a computer wakes (plugged in) = Enabled
#
# Required registry:
# HKLM\SOFTWARE\Policies\Microsoft\Power\PowerSettings\
# 0e796bdb-100d-47d6-a2d5-f7d2daa51f51
#
# ACSettingIndex = 1 (REG_DWORD)
# =====================================================================

$ErrorActionPreference = "Stop"

$STIGFolder = "C:\STIG"

$PolicyKey = "SOFTWARE\Policies\Microsoft\Power\PowerSettings\0e796bdb-100d-47d6-a2d5-f7d2daa51f51"

$RegistryPath = "HKLM:\SOFTWARE\Policies\Microsoft\Power\PowerSettings\0e796bdb-100d-47d6-a2d5-f7d2daa51f51"

$ValueName = "ACSettingIndex"

$RequiredValue = 1

$RegistryPol = "$env:SystemRoot\System32\GroupPolicy\Machine\Registry.pol"

$PolicyFile = "$env:TEMP\WN11-CC-000150.txt"


function Stop-Script {
    param(
        [string]$Message
    )

    Write-Host ""
    Write-Host "====================================================" -ForegroundColor Red
    Write-Host " ERROR"
    Write-Host "====================================================" -ForegroundColor Red
    Write-Host ""
    Write-Host $Message -ForegroundColor Red
    Write-Host ""

    Read-Host "Press ENTER to close"
    exit 1
}


# ---------------------------------------------------------------------
# ADMINISTRATOR CHECK
# ---------------------------------------------------------------------

$Identity = [Security.Principal.WindowsIdentity]::GetCurrent()

$Principal = New-Object `
    Security.Principal.WindowsPrincipal($Identity)

if (-not $Principal.IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator
)) {

    Stop-Script "PowerShell must be run as Administrator."
}


Write-Host ""
Write-Host "====================================================" -ForegroundColor Cyan
Write-Host " WN11-CC-000150 REMEDIATION"
Write-Host "====================================================" -ForegroundColor Cyan
Write-Host ""


# ---------------------------------------------------------------------
# FIND LGPO.EXE
# ---------------------------------------------------------------------

Write-Host "[1] Searching for LGPO.exe..." -ForegroundColor Cyan

$LGPO = Get-ChildItem `
    -Path $STIGFolder `
    -Filter "LGPO.exe" `
    -File `
    -Recurse `
    -ErrorAction SilentlyContinue |
    Select-Object -First 1 -ExpandProperty FullName


if (-not $LGPO) {

    Stop-Script "LGPO.exe was not found under C:\STIG."
}


Write-Host "    Found: $LGPO" -ForegroundColor Green
Write-Host ""


# ---------------------------------------------------------------------
# VERIFY LGPO SIGNATURE
# ---------------------------------------------------------------------

Write-Host "[2] Verifying LGPO.exe..." -ForegroundColor Cyan

$Signature = Get-AuthenticodeSignature $LGPO


if ($Signature.Status -ne "Valid") {

    Stop-Script "LGPO.exe does not have a valid digital signature."
}


if ($Signature.SignerCertificate.Subject -notmatch "Microsoft") {

    Stop-Script "LGPO.exe is not signed by Microsoft."
}


Write-Host "    Microsoft signature verified." -ForegroundColor Green
Write-Host ""


# ---------------------------------------------------------------------
# CREATE LGPO TEXT FILE
# ---------------------------------------------------------------------

Write-Host "[3] Creating policy definition..." -ForegroundColor Cyan


$PolicyText = @(
    "Computer"
    $PolicyKey
    $ValueName
    "DWORD:1"
    ""
) -join "`r`n"


[System.IO.File]::WriteAllText(
    $PolicyFile,
    $PolicyText,
    [System.Text.Encoding]::ASCII
)


Write-Host ""
Write-Host "Policy being applied:"
Write-Host "----------------------------------------------------"

Get-Content $PolicyFile | Out-Host

Write-Host "----------------------------------------------------"
Write-Host ""


# ---------------------------------------------------------------------
# IMPORT INTO LOCAL GROUP POLICY
# ---------------------------------------------------------------------

Write-Host "[4] Importing setting into Local Group Policy..." `
    -ForegroundColor Cyan

& $LGPO /v /t $PolicyFile


$LGPOExit = $LASTEXITCODE


Write-Host ""
Write-Host "LGPO Exit Code: $LGPOExit"
Write-Host ""


if ($LGPOExit -ne 0) {

    Stop-Script "LGPO failed to import the policy."
}


Write-Host "    LGPO import succeeded." -ForegroundColor Green
Write-Host ""


# ---------------------------------------------------------------------
# VERIFY REGISTRY.POL
# ---------------------------------------------------------------------

Write-Host "[5] Verifying Registry.pol..." -ForegroundColor Cyan


if (-not (Test-Path $RegistryPol)) {

    Stop-Script "Registry.pol was not found."
}


$ParsedPolicy = & $LGPO /parse /m $RegistryPol

$ParsedText = $ParsedPolicy -join "`n"


$ExpectedBlock = @"
Computer
$PolicyKey
$ValueName
DWORD:1
"@


if (
    $ParsedText -notmatch [regex]::Escape($PolicyKey) -or
    $ParsedText -notmatch [regex]::Escape($ValueName)
) {

    Write-Host ""
    Write-Host "Relevant Registry.pol entries:" -ForegroundColor Yellow

    $ParsedPolicy |
        Select-String `
            -Pattern "PowerSettings|ACSettingIndex" `
            -Context 2,2 |
        Out-Host

    Stop-Script "ACSettingIndex was NOT found in Registry.pol."
}


Write-Host "    ACSettingIndex exists in Registry.pol." `
    -ForegroundColor Green

Write-Host ""


# ---------------------------------------------------------------------
# APPLY GROUP POLICY
# ---------------------------------------------------------------------

Write-Host "[6] Running GPUPDATE..." -ForegroundColor Cyan
Write-Host ""

gpupdate.exe /target:computer /force

$GPResult = $LASTEXITCODE

Write-Host ""
Write-Host "GPUPDATE Exit Code: $GPResult"
Write-Host ""


# ---------------------------------------------------------------------
# VERIFY LIVE REGISTRY
# ---------------------------------------------------------------------

Write-Host "[7] Verifying STIG registry value..." `
    -ForegroundColor Cyan


try {

    $CurrentValue = (
        Get-ItemProperty `
            -Path $RegistryPath `
            -Name $ValueName `
            -ErrorAction Stop
    ).$ValueName

}
catch {

    Stop-Script "ACSettingIndex does not exist in the registry."
}


Write-Host ""
Write-Host "Registry:"
Write-Host "HKLM\$PolicyKey"
Write-Host ""

Write-Host "Value Name : ACSettingIndex"
Write-Host "Required   : 1"
Write-Host "Actual     : $CurrentValue"
Write-Host ""


if ($CurrentValue -ne 1) {

    Stop-Script "ACSettingIndex is not equal to 1."
}


# ---------------------------------------------------------------------
# REG.EXE CHECK
# ---------------------------------------------------------------------

Write-Host "REG.EXE verification:" -ForegroundColor Cyan
Write-Host ""

reg.exe query `
    "HKLM\SOFTWARE\Policies\Microsoft\Power\PowerSettings\0e796bdb-100d-47d6-a2d5-f7d2daa51f51" `
    /v ACSettingIndex


# ---------------------------------------------------------------------
# SUCCESS
# ---------------------------------------------------------------------

Write-Host ""
Write-Host "====================================================" `
    -ForegroundColor Green

Write-Host " WN11-CC-000150 - SUCCESS"

Write-Host "====================================================" `
    -ForegroundColor Green

Write-Host ""

Write-Host "Registry.pol   : VERIFIED" -ForegroundColor Green
Write-Host "ACSettingIndex : REG_DWORD 0x1" -ForegroundColor Green

Write-Host ""

Write-Host "Close Local Group Policy Editor if it is open."
Write-Host "Then reopen gpedit.msc and navigate to:"
Write-Host ""

Write-Host "Computer Configuration"
Write-Host " > Administrative Templates"
Write-Host " > System"
Write-Host " > Power Management"
Write-Host " > Sleep Settings"

Write-Host ""

Write-Host '"Require a password when a computer wakes (plugged in)"'
Write-Host ""

Write-Host "It should display: Enabled" -ForegroundColor Green

Write-Host ""

Remove-Item `
    $PolicyFile `
    -Force `
    -ErrorAction SilentlyContinue


Read-Host "Press ENTER to close"
