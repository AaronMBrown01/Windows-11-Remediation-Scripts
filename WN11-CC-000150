<#
.SYNOPSIS
    This PowerShell script ensures that Windows 11 prompts users for a password when waking from sleep while on AC power (plugged in).

.NOTES
    Author          : Aaron M Brown
    LinkedIn        : https://www.linkedin.com/in/aaron-m-brown-9a2b76258/
    GitHub          : https://github.com/AaronMBrown01
    Date Created    : 2026-08-18
    Last Modified   : 2026-08-18
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000150
    Documentation   : https://stigaview.com/products/win11/v2r8/WN11-CC-000150/

.TESTED ON
    Date(s) Tested  : 
    Tested By       : 
    Systems Tested  : 
    PowerShell Ver. : 

.USAGE
    Put any usage instructions here.
    Example syntax:
    PS C:\> .\STIG-ID-WN11-CC-000150.ps1 
#>

# YOUR CODE GOES HERE

# ================================================================
# STIG ID: WN11-CC-000150
#
# Require a password when a computer wakes (plugged in)
#
# Configures:
# Computer Configuration
#   Administrative Templates
#     System
#       Power Management
#         Sleep Settings
#           Require a password when a computer wakes (plugged in)
#
# Required Registry Setting:
#
# HKLM\SOFTWARE\Policies\Microsoft\Power\PowerSettings\
# 0e796bdb-100d-47d6-a2d5-f7d2daa51f51
#
# ACSettingIndex = 1 (REG_DWORD)
#
# REQUIREMENT:
# Microsoft LGPO.exe
# ================================================================


# ------------------------------------------------
# Verify Administrator privileges
# ------------------------------------------------

$CurrentIdentity = [Security.Principal.WindowsIdentity]::GetCurrent()

$Principal = New-Object Security.Principal.WindowsPrincipal(
    $CurrentIdentity
)

if (-not $Principal.IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator
)) {

    Write-Host ""
    Write-Host "ERROR: PowerShell must be run as Administrator." `
        -ForegroundColor Red

    exit 1
}


# ------------------------------------------------
# Locate LGPO.exe
# ------------------------------------------------

$PossibleLGPOPaths = @(
    "$PSScriptRoot\LGPO.exe",
    "C:\Windows\System32\LGPO.exe",
    "C:\Tools\LGPO.exe",
    "C:\LGPO\LGPO.exe"
)

$LGPO = $PossibleLGPOPaths |
    Where-Object { Test-Path $_ } |
    Select-Object -First 1


if (-not $LGPO) {

    Write-Host ""
    Write-Host "ERROR: LGPO.exe was not found." `
        -ForegroundColor Red

    Write-Host ""
    Write-Host "Place LGPO.exe in the same folder as this script."
    Write-Host ""

    exit 1
}


Write-Host ""
Write-Host "LGPO utility found:" -ForegroundColor Cyan
Write-Host $LGPO


# ------------------------------------------------
# STIG configuration
# ------------------------------------------------

$PolicyPath = "SOFTWARE\Policies\Microsoft\Power\PowerSettings\0e796bdb-100d-47d6-a2d5-f7d2daa51f51"

$RegistryPath = "HKLM:\SOFTWARE\Policies\Microsoft\Power\PowerSettings\0e796bdb-100d-47d6-a2d5-f7d2daa51f51"

$ValueName = "ACSettingIndex"

$RequiredValue = 1


# ------------------------------------------------
# Create temporary LGPO text file
#
# LGPO text format:
#
# Computer
# <registry path>
# <value name>
# DWORD:<value>
# ------------------------------------------------

$LGPOText = @"
Computer
$PolicyPath
$ValueName
DWORD:1
"@


$TempFile = Join-Path $env:TEMP "WN11-CC-000150.txt"

$LGPOText | Set-Content `
    -Path $TempFile `
    -Encoding ASCII `
    -Force


Write-Host ""
Write-Host "====================================================="
Write-Host " Configuring WN11-CC-000150"
Write-Host "====================================================="
Write-Host ""


# ------------------------------------------------
# Apply setting to Local Group Policy
# ------------------------------------------------

Write-Host "Writing setting to Local Group Policy..." `
    -ForegroundColor Cyan

& $LGPO /t $TempFile


if ($LASTEXITCODE -ne 0) {

    Write-Host ""
    Write-Host "ERROR: LGPO.exe failed to apply the policy." `
        -ForegroundColor Red

    Remove-Item $TempFile -Force -ErrorAction SilentlyContinue

    exit 1
}


Write-Host ""
Write-Host "Local Group Policy updated successfully." `
    -ForegroundColor Green


# ------------------------------------------------
# Force Group Policy refresh
# ------------------------------------------------

Write-Host ""
Write-Host "Refreshing Group Policy..." `
    -ForegroundColor Cyan

gpupdate /target:computer /force


# ------------------------------------------------
# Directly verify / reinforce registry value
# ------------------------------------------------

Write-Host ""
Write-Host "Verifying registry configuration..." `
    -ForegroundColor Cyan


if (-not (Test-Path $RegistryPath)) {

    New-Item `
        -Path $RegistryPath `
        -Force |
        Out-Null
}


New-ItemProperty `
    -Path $RegistryPath `
    -Name $ValueName `
    -Value $RequiredValue `
    -PropertyType DWord `
    -Force |
    Out-Null


# ------------------------------------------------
# Read back result
# ------------------------------------------------

try {

    $Result = Get-ItemProperty `
        -Path $RegistryPath `
        -Name $ValueName `
        -ErrorAction Stop

    $CurrentValue = $Result.$ValueName

}
catch {

    Write-Host ""
    Write-Host "FAIL - Registry value could not be read." `
        -ForegroundColor Red

    exit 1
}


# ------------------------------------------------
# Final STIG verification
# ------------------------------------------------

Write-Host ""
Write-Host "====================================================="
Write-Host " WN11-CC-000150 Verification"
Write-Host "====================================================="
Write-Host ""

Write-Host "Registry Path:"
Write-Host "HKLM\SOFTWARE\Policies\Microsoft\Power\PowerSettings\0e796bdb-100d-47d6-a2d5-f7d2daa51f51"

Write-Host ""
Write-Host "Value Name : $ValueName"
Write-Host "Value Type : REG_DWORD"
Write-Host "Value      : $CurrentValue"
Write-Host ""


if ($CurrentValue -eq $RequiredValue) {

    Write-Host "PASS - WN11-CC-000150 is configured correctly." `
        -ForegroundColor Green

    Write-Host ""
    Write-Host "Expected:"
    Write-Host "ACSettingIndex = 1"
    Write-Host ""
    Write-Host "Actual:"
    Write-Host "ACSettingIndex = $CurrentValue"

}
else {

    Write-Host "FAIL - WN11-CC-000150 is NOT configured correctly." `
        -ForegroundColor Red

    exit 1
}


# ------------------------------------------------
# Cleanup
# ------------------------------------------------

Remove-Item `
    $TempFile `
    -Force `
    -ErrorAction SilentlyContinue


Write-Host ""
Write-Host "Configuration complete." `
    -ForegroundColor Green

Write-Host ""
Write-Host "Open gpedit.msc and navigate to:"
Write-Host ""
Write-Host "Computer Configuration"
Write-Host " > Administrative Templates"
Write-Host " > System"
Write-Host " > Power Management"
Write-Host " > Sleep Settings"
Write-Host ""
Write-Host '"Require a password when a computer wakes (plugged in)"'
Write-Host ""
Write-Host "The policy should now show as Enabled."
Write-Host ""
