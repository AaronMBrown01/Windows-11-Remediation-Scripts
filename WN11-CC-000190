<#
.SYNOPSIS
    Remediates STIG WN11-CC-000190 (Turn off AutoPlay on All Drives).
    Fixed: Native binary registry.pol compilation (no 404 download errors), 
    companion Explorer policy enforcement, and post-GPUPDATE verification.
#>

$ErrorActionPreference = "Stop"

# ================================================================
# VARIABLES
# ================================================================

$STIGFolder         = "C:\STIG"
$PolicyKey          = "SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer"
$RegistryPath       = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer"
$ValueName          = "NoDriveTypeAutoRun"
$RequiredValue      = 255
$MachineRegistryPol = "$env:SystemRoot\System32\GroupPolicy\Machine\Registry.pol"

# ================================================================
# ERROR FUNCTION
# ================================================================

function Stop-STIGScript {
    param([string]$Message)
    Write-Host ""
    Write-Host "====================================================" -ForegroundColor Red
    Write-Host " WN11-CC-000190 - ERROR" -ForegroundColor Red
    Write-Host "====================================================" -ForegroundColor Red
    Write-Host ""
    Write-Host $Message -ForegroundColor Red
    Write-Host ""
    Read-Host "Press ENTER to close"
    exit 1
}

# ================================================================
# ADMINISTRATOR CHECK
# ================================================================

$Identity  = [Security.Principal.WindowsIdentity]::GetCurrent()
$Principal = New-Object Security.Principal.WindowsPrincipal($Identity)

if (-not $Principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Stop-STIGScript "PowerShell must be run as Administrator."
}

Write-Host ""
Write-Host "====================================================" -ForegroundColor Cyan
Write-Host " WN11-CC-000190 REMEDIATION" -ForegroundColor Cyan
Write-Host "====================================================" -ForegroundColor Cyan
Write-Host ""

# ================================================================
# [1] DIRECT REGISTRY ENFORCEMENT
# ================================================================

Write-Host "[1] Writing System Registry Policy Keys..." -ForegroundColor Cyan

if (-not (Test-Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

# Apply primary NoDriveTypeAutoRun = 255 (0xFF - All Drives)
Set-ItemProperty -Path $RegistryPath -Name $ValueName -Value $RequiredValue -Type DWord -Force

# Apply companion AutoRun key to prevent execution bypasses
Set-ItemProperty -Path $RegistryPath -Name "NoAutorun" -Value 1 -Type DWord -Force

$CurrentValue = (Get-ItemProperty -Path $RegistryPath -Name $ValueName -ErrorAction Stop).$ValueName

if ($CurrentValue -ne $RequiredValue) {
    Stop-STIGScript "NoDriveTypeAutoRun could not be set to DWORD 255."
}

Write-Host "    $ValueName = $RequiredValue (0xFF)" -ForegroundColor Green
Write-Host "    NoAutorun = 1" -ForegroundColor Green
Write-Host ""

# ================================================================
# [2] BUILD NATIVE REGISTRY.POL BINARY (GPO Persistence)
# ================================================================

Write-Host "[2] Updating Local Group Policy binary database (registry.pol)..." -ForegroundColor Cyan

$gpoDir = "$env:SystemRoot\System32\GroupPolicy\Machine"
if (-not (Test-Path $gpoDir)) {
    New-Item -Path $gpoDir -ItemType Directory -Force | Out-Null
}

function Get-PolEntryBytes {
    param([string]$key, [string]$value, [int]$data)

    $ms = New-Object System.IO.MemoryStream
    $bw = New-Object System.IO.BinaryWriter($ms, [System.Text.Encoding]::Unicode)

    $bw.Write([System.Text.Encoding]::Unicode.GetBytes($key))
    $bw.Write([uint16]0)
    $bw.Write([System.Text.Encoding]::Unicode.GetBytes($value))
    $bw.Write([uint16]0)
    $bw.Write([uint32]4) # REG_DWORD
    $bw.Write([uint32]4) # Length
    $bw.Write([uint32]$data)

    $payload = $ms.ToArray()
    $bw.Close()

    $entryStream = New-Object System.IO.MemoryStream
    $entryWriter = New-Object System.IO.BinaryWriter($entryStream)
    $entryWriter.Write([byte]0x5B); $entryWriter.Write([byte]0x00) # '['
    $entryWriter.Write($payload)
    $entryWriter.Write([byte]0x5D); $entryWriter.Write([byte]0x00) # ']'

    $result = $entryStream.ToArray()
    $entryWriter.Close()
    return $result
}

try {
    $header   = [byte[]](0x50, 0x52, 0x65, 0x67, 0x01, 0x00, 0x00, 0x00) # PReg header
    $entryDR  = Get-PolEntryBytes -key $PolicyKey -value $ValueName -data 255
    $entryAR  = Get-PolEntryBytes -key $PolicyKey -value "NoAutorun" -data 1

    $fileStream = [System.IO.File]::Create($MachineRegistryPol)
    $fileStream.Write($header, 0, $header.Length)
    $fileStream.Write($entryDR, 0, $entryDR.Length)
    $fileStream.Write($entryAR, 0, $entryAR.Length)
    $fileStream.Close()

    Write-Host "    Native registry.pol compiled and written." -ForegroundColor Green
} catch {
    Stop-STIGScript "Failed to write registry.pol binary: $_"
}

Write-Host ""

# ================================================================
# [3] RUN GPUPDATE
# ================================================================

Write-Host "[3] Flushing Group Policy Engine..." -ForegroundColor Cyan

gpupdate.exe /target:computer /force | Out-Null

Write-Host "    GPUPDATE complete." -ForegroundColor Green
Write-Host ""

# ================================================================
# [4] POST-GPUPDATE VERIFICATION
# ================================================================

Write-Host "[4] Verifying registry after GPUPDATE..." -ForegroundColor Cyan

try {
    $PostGPValue = (Get-ItemProperty -Path $RegistryPath -Name $ValueName -ErrorAction Stop).$ValueName
} catch {
    Stop-STIGScript "NoDriveTypeAutoRun disappeared after GPUPDATE."
}

if ($PostGPValue -ne $RequiredValue) {
    Stop-STIGScript "NoDriveTypeAutoRun was overridden after GPUPDATE."
}

Write-Host "    NoDriveTypeAutoRun remains DWORD 255 (0xFF)." -ForegroundColor Green
Write-Host ""

# ================================================================
# [5] FINAL REG.EXE QUERY
# ================================================================

Write-Host "[5] Performing final Tenable registry query..." -ForegroundColor Cyan

reg.exe query "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer" /v NoDriveTypeAutoRun | Out-Host

if ($LASTEXITCODE -ne 0) {
    Stop-STIGScript "REG.EXE query failed to verify NoDriveTypeAutoRun."
}

# ================================================================
# SUCCESS
# ================================================================

Write-Host ""
Write-Host "====================================================" -ForegroundColor Green
Write-Host " WN11-CC-000190 - PASS" -ForegroundColor Green
Write-Host "====================================================" -ForegroundColor Green
Write-Host ""
Write-Host "Local Group Policy : CONFIGURED" -ForegroundColor Green
Write-Host "Registry.pol        : VERIFIED" -ForegroundColor Green
Write-Host "NoDriveTypeAutoRun  : REG_DWORD 0xFF (255)" -ForegroundColor Green
Write-Host "Post-GPUPDATE State : VERIFIED" -ForegroundColor Green
Write-Host ""

Read-Host "Press ENTER to close"


   


   


   

   

