<#
.SYNOPSIS
    Remediates STIG WN11-CC-000190.

.DESCRIPTION
    Configures:

    Computer Configuration
      > Administrative Templates
      > Windows Components
      > AutoPlay Policies
      > Turn off AutoPlay

    Required setting:
      Enabled
      Turn off AutoPlay on: All drives

    Required registry value:

    HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer

    NoDriveTypeAutoRun = 255 (REG_DWORD)

.NOTES
    STIG-ID : WN11-CC-000190
    Version : 5.0
#>

$ErrorActionPreference = "Stop"

# ================================================================
# VARIABLES
# ================================================================

$STIGFolder = "C:\STIG"

$PolicyKey =
"SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer"

$RegistryPath =
"HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer"

$ValueName     = "NoDriveTypeAutoRun"
$RequiredValue = 255

$MachineRegistryPol =
"$env:SystemRoot\System32\GroupPolicy\Machine\Registry.pol"

$TempLGPOText =
Join-Path $env:TEMP "WN11-CC-000190.txt"

$TempRegistryPol =
Join-Path $env:TEMP "WN11-CC-000190-Registry.pol"

$LGPOZip =
Join-Path $STIGFolder "LGPO.zip"

$LGPOExtract =
Join-Path $STIGFolder "LGPO"


# ================================================================
# ERROR FUNCTION
# ================================================================

function Stop-STIGScript {

    param(
        [string]$Message
    )

    Write-Host ""
    Write-Host "====================================================" -ForegroundColor Red
    Write-Host " WN11-CC-000190 - ERROR"
    Write-Host "====================================================" -ForegroundColor Red
    Write-Host ""
    Write-Host $Message -ForegroundColor Red
    Write-Host ""

    Read-Host "Press ENTER to close"
    exit 1
}


# ================================================================
# ADMINISTRATOR CHECK
# ================================================================

$Identity =
[Security.Principal.WindowsIdentity]::GetCurrent()

$Principal =
New-Object Security.Principal.WindowsPrincipal($Identity)

if (-not $Principal.IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator
)) {

    Stop-STIGScript `
        "PowerShell must be run as Administrator."
}


Write-Host ""
Write-Host "====================================================" -ForegroundColor Cyan
Write-Host " WN11-CC-000190 REMEDIATION"
Write-Host "====================================================" -ForegroundColor Cyan
Write-Host ""


# ================================================================
# CREATE STIG DIRECTORY
# ================================================================

if (-not (Test-Path $STIGFolder)) {

    Write-Host "[1] Creating C:\STIG..." -ForegroundColor Cyan

    New-Item `
        -Path $STIGFolder `
        -ItemType Directory `
        -Force |
        Out-Null
}


# ================================================================
# SEARCH FOR LGPO.EXE
# ================================================================

Write-Host "[2] Searching for LGPO.exe..." `
    -ForegroundColor Cyan

$LGPO = Get-ChildItem `
    -Path $STIGFolder `
    -Filter "LGPO.exe" `
    -File `
    -Recurse `
    -ErrorAction SilentlyContinue |
    Select-Object -First 1 -ExpandProperty FullName


if (-not $LGPO) {

    $PossiblePaths = @(
        "$PSScriptRoot\LGPO.exe",
        "C:\Windows\System32\LGPO.exe",
        "C:\Tools\LGPO.exe",
        "C:\LGPO\LGPO.exe"
    )

    $LGPO =
    $PossiblePaths |
    Where-Object { Test-Path $_ } |
    Select-Object -First 1
}


# ================================================================
# DOWNLOAD LGPO IF MISSING
# ================================================================

if (-not $LGPO) {

    Write-Host ""
    Write-Host "LGPO.exe not found." -ForegroundColor Yellow
    Write-Host "Downloading Microsoft LGPO utility..." -ForegroundColor Cyan
    Write-Host ""

    $LGPOUrl =
    "https://download.microsoft.com/download/8/5/C/85C25433-A1B0-4FFA-9429-7E023E7DA8D8/LGPO.zip"

    try {

        [Net.ServicePointManager]::SecurityProtocol =
        [Net.ServicePointManager]::SecurityProtocol -bor
        [Net.SecurityProtocolType]::Tls12

        Invoke-WebRequest `
            -Uri $LGPOUrl `
            -OutFile $LGPOZip `
            -UseBasicParsing
    }
    catch {

        Stop-STIGScript `
            "Failed to download LGPO.zip. $($_.Exception.Message)"
    }


    if (-not (Test-Path $LGPOZip)) {

        Stop-STIGScript `
            "LGPO.zip was not downloaded."
    }


    Write-Host "    Download complete." `
        -ForegroundColor Green

    Write-Host ""


    # ============================================================
    # EXTRACT LGPO
    # ============================================================

    Write-Host "[3] Extracting LGPO.zip..." `
        -ForegroundColor Cyan

    if (Test-Path $LGPOExtract) {

        Remove-Item `
            $LGPOExtract `
            -Recurse `
            -Force
    }

    Expand-Archive `
        -Path $LGPOZip `
        -DestinationPath $LGPOExtract `
        -Force


    $LGPO =
    Get-ChildItem `
        -Path $LGPOExtract `
        -Filter "LGPO.exe" `
        -File `
        -Recurse `
        -ErrorAction SilentlyContinue |
        Select-Object -First 1 -ExpandProperty FullName


    if (-not $LGPO) {

        Stop-STIGScript `
            "LGPO.exe was not found after extraction."
    }
}


Write-Host ""
Write-Host "LGPO.exe found:" -ForegroundColor Green
Write-Host $LGPO
Write-Host ""


# ================================================================
# VERIFY MICROSOFT SIGNATURE
# ================================================================

Write-Host "[4] Verifying LGPO.exe digital signature..." `
    -ForegroundColor Cyan

$Signature =
Get-AuthenticodeSignature $LGPO


if ($Signature.Status -ne "Valid") {

    Stop-STIGScript `
        "LGPO.exe does not have a valid digital signature."
}


if ($Signature.SignerCertificate.Subject -notmatch "Microsoft") {

    Stop-STIGScript `
        "LGPO.exe is not signed by Microsoft."
}


Write-Host "    Microsoft signature verified." `
    -ForegroundColor Green

Write-Host ""


# ================================================================
# CREATE LGPO TEXT FILE
# ================================================================

Write-Host "[5] Creating LGPO policy definition..." `
    -ForegroundColor Cyan


$PolicyText = @(
    "Computer"
    $PolicyKey
    $ValueName
    "DWORD:255"
    ""
) -join "`r`n"


[System.IO.File]::WriteAllText(
    $TempLGPOText,
    $PolicyText,
    [System.Text.Encoding]::ASCII
)


Write-Host ""
Write-Host "Policy definition:"
Write-Host "----------------------------------------------------"

Get-Content $TempLGPOText |
    Out-Host

Write-Host "----------------------------------------------------"
Write-Host ""


# ================================================================
# BUILD TEMPORARY REGISTRY.POL
# ================================================================

Write-Host "[6] Building temporary Registry.pol..." `
    -ForegroundColor Cyan


if (Test-Path $TempRegistryPol) {

    Remove-Item `
        $TempRegistryPol `
        -Force
}


& $LGPO `
    /r $TempLGPOText `
    /w $TempRegistryPol `
    /v


$BuildExitCode =
$LASTEXITCODE


if ($BuildExitCode -ne 0) {

    Stop-STIGScript `
        "LGPO failed to build the temporary Registry.pol. Exit code: $BuildExitCode"
}


if (-not (Test-Path $TempRegistryPol)) {

    Stop-STIGScript `
        "Temporary Registry.pol was not created."
}


Write-Host "    Temporary Registry.pol created." `
    -ForegroundColor Green

Write-Host ""


# ================================================================
# IMPORT INTO LOCAL MACHINE POLICY
# ================================================================

Write-Host "[7] Importing WN11-CC-000190 into Local Group Policy..." `
    -ForegroundColor Cyan


& $LGPO `
    /m $TempRegistryPol `
    /v


$ImportExitCode =
$LASTEXITCODE


if ($ImportExitCode -ne 0) {

    Stop-STIGScript `
        "LGPO failed to import WN11-CC-000190. Exit code: $ImportExitCode"
}


Write-Host "    Local Group Policy import succeeded." `
    -ForegroundColor Green

Write-Host ""


# ================================================================
# VERIFY ACTIVE REGISTRY.POL
# ================================================================

Write-Host "[8] Verifying active Registry.pol..." `
    -ForegroundColor Cyan


if (-not (Test-Path $MachineRegistryPol)) {

    Stop-STIGScript `
        "Active Machine Registry.pol was not found."
}


$ParsedPolicy =
& $LGPO `
    /parse `
    /m $MachineRegistryPol


$ParsedText =
$ParsedPolicy -join "`n"


if (
    $ParsedText -notmatch [regex]::Escape($PolicyKey) -or
    $ParsedText -notmatch [regex]::Escape($ValueName)
) {

    Stop-STIGScript `
        "WN11-CC-000190 was not found in active Registry.pol."
}


Write-Host "    WN11-CC-000190 found in Registry.pol." `
    -ForegroundColor Green

Write-Host ""


# ================================================================
# FORCE EXACT STIG / TENABLE REGISTRY VALUE
# ================================================================

Write-Host "[9] Writing required STIG registry value..." `
    -ForegroundColor Cyan


if (-not (Test-Path $RegistryPath)) {

    New-Item `
        -Path $RegistryPath `
        -Force |
        Out-Null
}


New-ItemProperty `
    -Path $RegistryPath `
    -Name $ValueName `
    -PropertyType DWord `
    -Value $RequiredValue `
    -Force |
    Out-Null


$CurrentValue =
(
    Get-ItemProperty `
        -Path $RegistryPath `
        -Name $ValueName `
        -ErrorAction Stop
).$ValueName


if ($CurrentValue -ne $RequiredValue) {

    Stop-STIGScript `
        "NoDriveTypeAutoRun could not be set to DWORD 255."
}


Write-Host "    NoDriveTypeAutoRun = 255 (0xFF)." `
    -ForegroundColor Green

Write-Host ""


# ================================================================
# RUN GPUPDATE
# ================================================================

Write-Host "[10] Running GPUPDATE..." `
    -ForegroundColor Cyan

Write-Host ""


gpupdate.exe /target:computer /force


$GPUpdateExit =
$LASTEXITCODE


Write-Host ""
Write-Host "GPUPDATE Exit Code: $GPUpdateExit"
Write-Host ""


# ================================================================
# VERIFY AFTER GPUPDATE
# ================================================================

Write-Host "[11] Verifying registry after GPUPDATE..." `
    -ForegroundColor Cyan


try {

    $PostGPValue =
    (
        Get-ItemProperty `
            -Path $RegistryPath `
            -Name $ValueName `
            -ErrorAction Stop
    ).$ValueName

}
catch {

    Stop-STIGScript `
        "NoDriveTypeAutoRun disappeared after GPUPDATE."
}


if ($PostGPValue -ne $RequiredValue) {

    Stop-STIGScript `
        "NoDriveTypeAutoRun changed after GPUPDATE."
}


Write-Host `
    "    NoDriveTypeAutoRun remains DWORD 255 after GPUPDATE." `
    -ForegroundColor Green

Write-Host ""


# ================================================================
# FINAL TENABLE-STYLE REGISTRY CHECK
# ================================================================

Write-Host "[12] Final registry verification..." `
    -ForegroundColor Cyan

Write-Host ""


reg.exe query `
    "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer" `
    /v NoDriveTypeAutoRun


if ($LASTEXITCODE -ne 0) {

    Stop-STIGScript `
        "REG.EXE could not verify NoDriveTypeAutoRun."
}


# ================================================================
# FINAL RESULT
# ================================================================

Write-Host ""
Write-Host "====================================================" `
    -ForegroundColor Green

Write-Host " WN11-CC-000190 - PASS"

Write-Host "====================================================" `
    -ForegroundColor Green

Write-Host ""

Write-Host "Local Group Policy : CONFIGURED" `
    -ForegroundColor Green

Write-Host "Registry.pol       : VERIFIED" `
    -ForegroundColor Green

Write-Host "NoDriveTypeAutoRun : REG_DWORD 0xFF (255)" `
    -ForegroundColor Green

Write-Host "Post-GPUPDATE      : VERIFIED" `
    -ForegroundColor Green

Write-Host ""

Write-Host "GPEDIT should show:"
Write-Host ""

Write-Host `
'"Turn off AutoPlay" = Enabled' `
    -ForegroundColor Green

Write-Host `
'"Turn off AutoPlay on:" = All drives' `
    -ForegroundColor Green

Write-Host ""

Write-Host "Tenable should see:"
Write-Host ""

Write-Host `
"NoDriveTypeAutoRun    REG_DWORD    0xff" `
    -ForegroundColor Green

Write-Host ""


# ================================================================
# CLEANUP
# ================================================================

Remove-Item `
    $TempLGPOText `
    -Force `
    -ErrorAction SilentlyContinue


Remove-Item `
    $TempRegistryPol `
    -Force `
    -ErrorAction SilentlyContinue


Read-Host "Press ENTER to close"

   

