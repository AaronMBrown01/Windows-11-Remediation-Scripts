  <#
.SYNOPSIS
    Remediates STIG WN11-CC-000190.

.DESCRIPTION
    Configures:
    Computer Configuration
      > Administrative Templates
      > Windows Components
      > AutoPlay Policies
      > Turn off AutoPlay

    Required setting:
      Enabled
      All drives

    Required registry value:
    HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer

    NoDriveTypeAutoRun = 255 (REG_DWORD)

.NOTES
    STIG-ID : WN11-CC-000190
    Version : 6.0
#>

$ErrorActionPreference = "Stop"

$STIGFolder    = "C:\STIG"
$PolicyKey     = "SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer"
$RegistryPath  = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer"
$ValueName     = "NoDriveTypeAutoRun"
$RequiredValue = 255

$MachineRegistryPol = "$env:SystemRoot\System32\GroupPolicy\Machine\Registry.pol"
$TempLGPOText       = Join-Path $env:TEMP "WN11-CC-000190.txt"
$TempRegistryPol    = Join-Path $env:TEMP "WN11-CC-000190-Registry.pol"
$LGPOZip            = Join-Path $STIGFolder "LGPO.zip"
$LGPOExtract        = Join-Path $STIGFolder "LGPO"

function Stop-STIGScript {
    param([string]$Message)

    Write-Host ""
    Write-Host "====================================================" -ForegroundColor Red
    Write-Host " WN11-CC-000190 - ERROR" -ForegroundColor Red
    Write-Host "====================================================" -ForegroundColor Red
    Write-Host ""
    Write-Host $Message -ForegroundColor Red
    Write-Host ""
    Read-Host "Press ENTER to close"
    exit 1
}

$Identity  = [Security.Principal.WindowsIdentity]::GetCurrent()
$Principal = New-Object Security.Principal.WindowsPrincipal($Identity)

if (-not $Principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Stop-STIGScript "PowerShell must be run as Administrator."
}

Write-Host ""
Write-Host "====================================================" -ForegroundColor Cyan
Write-Host " WN11-CC-000190 REMEDIATION" -ForegroundColor Cyan
Write-Host "====================================================" -ForegroundColor Cyan
Write-Host ""

if (-not (Test-Path $STIGFolder)) {
    New-Item -Path $STIGFolder -ItemType Directory -Force | Out-Null
}

# Find LGPO
Write-Host "[1] Searching for LGPO.exe..." -ForegroundColor Cyan

$LGPO = Get-ChildItem -Path $STIGFolder -Filter "LGPO.exe" -File -Recurse -ErrorAction SilentlyContinue |
    Select-Object -First 1 -ExpandProperty FullName

if (-not $LGPO) {
    $PossiblePaths = @(
        "$PSScriptRoot\LGPO.exe",
        "C:\Windows\System32\LGPO.exe",
        "C:\Tools\LGPO.exe",
        "C:\LGPO\LGPO.exe",
        "C:\STIG\LGPO\LGPO_30\LGPO.exe"
    )
    $LGPO = $PossiblePaths | Where-Object { Test-Path $_ } | Select-Object -First 1
}

if (-not $LGPO) {
    Write-Host "    LGPO.exe not found. Downloading Microsoft LGPO.zip..." -ForegroundColor Yellow
    $LGPOUrl = "https://download.microsoft.com/download/8/5/C/85C25433-A1B0-4FFA-9429-7E023E7DA8D8/LGPO.zip"

    try {
        [Net.ServicePointManager]::SecurityProtocol =
            [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12

        Invoke-WebRequest -Uri $LGPOUrl -OutFile $LGPOZip -UseBasicParsing
        if (Test-Path $LGPOExtract) {
            Remove-Item $LGPOExtract -Recurse -Force
        }
        Expand-Archive -Path $LGPOZip -DestinationPath $LGPOExtract -Force

        $LGPO = Get-ChildItem -Path $LGPOExtract -Filter "LGPO.exe" -File -Recurse -ErrorAction SilentlyContinue |
            Select-Object -First 1 -ExpandProperty FullName
    }
    catch {
        Stop-STIGScript "Unable to download or extract LGPO.zip. $($_.Exception.Message)"
    }
}

if (-not $LGPO) {
    Stop-STIGScript "LGPO.exe could not be located."
}

Write-Host "    Found: $LGPO" -ForegroundColor Green

# Verify signature
Write-Host "[2] Verifying LGPO.exe..." -ForegroundColor Cyan
$Signature = Get-AuthenticodeSignature $LGPO

if ($Signature.Status -ne "Valid") {
    Stop-STIGScript "LGPO.exe does not have a valid digital signature."
}
if ($Signature.SignerCertificate.Subject -notmatch "Microsoft") {
    Stop-STIGScript "LGPO.exe is not signed by Microsoft."
}

# Create policy text
Write-Host "[3] Creating policy definition..." -ForegroundColor Cyan

$PolicyText = @(
    "Computer"
    $PolicyKey
    $ValueName
    "DWORD:255"
    ""
) -join "`r`n"

[System.IO.File]::WriteAllText($TempLGPOText, $PolicyText, [System.Text.Encoding]::ASCII)

# Build temp Registry.pol
Write-Host "[4] Building temporary Registry.pol..." -ForegroundColor Cyan
Remove-Item $TempRegistryPol -Force -ErrorAction SilentlyContinue

& $LGPO /r $TempLGPOText /w $TempRegistryPol /v

if ($LASTEXITCODE -ne 0) {
    Stop-STIGScript "LGPO failed to build the temporary Registry.pol."
}
if (-not (Test-Path $TempRegistryPol)) {
    Stop-STIGScript "Temporary Registry.pol was not created."
}

# Import
Write-Host "[5] Importing into Local Group Policy..." -ForegroundColor Cyan
& $LGPO /m $TempRegistryPol /v

if ($LASTEXITCODE -ne 0) {
    Stop-STIGScript "LGPO failed to import WN11-CC-000190."
}

# Effective registry
Write-Host "[6] Ensuring effective registry value..." -ForegroundColor Cyan

if (-not (Test-Path $RegistryPath)) {
    New-Item -Path $RegistryPath -Force | Out-Null
}

New-ItemProperty -Path $RegistryPath -Name $ValueName -PropertyType DWord -Value $RequiredValue -Force | Out-Null

# GPUPDATE
Write-Host "[7] Running GPUPDATE..." -ForegroundColor Cyan
gpupdate.exe /target:computer /force | Out-Host

# Verify active Registry.pol
Write-Host "[8] Verifying active Registry.pol..." -ForegroundColor Cyan

if (-not (Test-Path $MachineRegistryPol)) {
    Stop-STIGScript "Active Machine Registry.pol was not found."
}

$ParsedPolicy = & $LGPO /parse /m $MachineRegistryPol
$ParsedText   = $ParsedPolicy -join "`n"

if (
    $ParsedText -notmatch [regex]::Escape($PolicyKey) -or
    $ParsedText -notmatch [regex]::Escape($ValueName) -or
    $ParsedText -notmatch "DWORD:255"
) {
    Stop-STIGScript "WN11-CC-000190 was not verified in active Registry.pol."
}

# Verify registry
Write-Host "[9] Verifying live registry..." -ForegroundColor Cyan

$PostGPValue = (
    Get-ItemProperty -Path $RegistryPath -Name $ValueName -ErrorAction Stop
).$ValueName

if ($PostGPValue -ne $RequiredValue) {
    Stop-STIGScript "NoDriveTypeAutoRun is not equal to 255 after GPUPDATE."
}

reg.exe query `
    "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer" `
    /v NoDriveTypeAutoRun

if ($LASTEXITCODE -ne 0) {
    Stop-STIGScript "REG.EXE could not verify NoDriveTypeAutoRun."
}

Write-Host ""
Write-Host "====================================================" -ForegroundColor Green
Write-Host " WN11-CC-000190 - PASS" -ForegroundColor Green
Write-Host "====================================================" -ForegroundColor Green
Write-Host ""
Write-Host "Registry.pol       : VERIFIED" -ForegroundColor Green
Write-Host "NoDriveTypeAutoRun : REG_DWORD 0xFF (255)" -ForegroundColor Green
Write-Host "Post-GPUPDATE      : VERIFIED" -ForegroundColor Green
Write-Host ""

Remove-Item $TempLGPOText -Force -ErrorAction SilentlyContinue
Remove-Item $TempRegistryPol -Force -ErrorAction SilentlyContinue

Read-Host "Press ENTER to close"


   


   

   

